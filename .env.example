# Optional for local development.
# If DATABASE_URL is empty or unset, the backend uses SQLite in backend/data/.
DATABASE_URL=

# Required only when public registration should be protected by an invite code.
# Use a development value locally. Never commit the real production invite code.
REGISTRATION_INVITE_CODE=change-me-in-local-development

# Optional: choose a custom local SQLite data directory.
STUDY_TRACKER_DATA_DIR=backend/data
